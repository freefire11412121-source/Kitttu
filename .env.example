# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id

# Wallets (comma-separated private keys with 0x prefix)
PRIVATE_KEYS=0xabc123...,0xdef456...

# Optional: Railway deployment token
RAILWAY_TOKEN=your_railway_token

# ─── AutoScheduler Settings ──────────────────────────────────────────
# Disable auto-run (bot stays online, manual /run still works)
AUTO_RUN_DISABLED=0
# Random kickoff window (HH:MM UTC). Default: 00:15-06:00
AUTO_RUN_WINDOW_START=00:15
AUTO_RUN_WINDOW_END=06:00
# Path to persist schedule state (survives container restarts)
AUTO_SCHEDULE_PATH=./data/auto_schedule.json

# ─── MultiRunner Settings ────────────────────────────────────────────
# Max parallel wallets (1 = sequential, higher = concurrent)
PARALLEL_WALLETS=1
# How often (in completed wallets) to send Telegram progress beacon
BATCH_REPORT_EVERY=25
# Walk wallet list in reverse order (100→99→…→1)
REVERSE_ORDER=0
# Enable phase-3 sweep (retry failed actions once)
PHASE3_SWEEP=1
# Restrict to wallet id range (optional, leave empty for all)
WALLET_ID_MIN=
WALLET_ID_MAX=

# ─── Planner Settings ───────────────────────────────────────────────
# Start time spread window (minutes from midnight UTC)
PLAN_WINDOW_START_MINUTE=15
PLAN_WINDOW_END_MINUTE=1380

# ─── Vault Database ─────────────────────────────────────────────────
VAULT_DB_PATH=./data/vault.db
